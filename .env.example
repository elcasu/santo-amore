# Sanity CMS — copiá a `.env.local` y completá con tu proyecto
# Creá el proyecto en https://www.sanity.io/manage (plan Free)

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# true = mocks tipados; false = Sanity real
# Preferí USE_SANITY_MOCKS (server-only). NEXT_PUBLIC_* exige reiniciar `next dev`.
USE_SANITY_MOCKS=false
NEXT_PUBLIC_USE_SANITY_MOCKS=false

# Gate de staging (NO setear en Production de Vercel)
# Si SITE_PASSWORD está definido y VERCEL_ENV !== production, pide login en /acceso
# SITE_PASSWORD=tu-password-staging

# Opcional: drafts / preview (más adelante)
# SANITY_API_READ_TOKEN=
