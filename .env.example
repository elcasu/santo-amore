# Sanity CMS — copiá a `.env.local` y completá con tu proyecto
# Creá el proyecto en https://www.sanity.io/manage (plan Free)

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# true = mocks tipados; false = Sanity real
# Preferí USE_SANITY_MOCKS (server-only). NEXT_PUBLIC_* exige reiniciar `next dev`.
USE_SANITY_MOCKS=false
NEXT_PUBLIC_USE_SANITY_MOCKS=false

# Gate de staging (NO setear en Production de Vercel)
# Si SITE_PASSWORD está definido y VERCEL_ENV !== production, pide login en /acceso
# SITE_PASSWORD=tu-password-staging

# App ops móvil (/ops) — contraseña compartida del local
# OPS_PASSWORD=tu-password-ops

# Escritura de pedidos (token con permiso create/update en el dataset)
SANITY_API_WRITE_TOKEN=

# URL pública del sitio (back_urls + notification_url de MercadoPago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp (Cloud API + Chatwoot) — canal público de la marca
# Número E.164 sin +: código país + número (ej. Argentina 54911…)
# NEXT_PUBLIC_WHATSAPP_PHONE=54911XXXXXXXX
# Texto opcional al abrir el chat desde la web
# NEXT_PUBLIC_WHATSAPP_PREFILL=Hola, consulta desde la web de Santo Amore.
# Dashboard Chatwoot del staff (link Inbox en /ops)
# NEXT_PUBLIC_OPS_INBOX_URL=https://app.chatwoot.com/app/accounts/ID/dashboard

# MercadoPago Checkout Pro
# https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# Secret de Webhooks (firma x-signature) — Mis integraciones → Webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# Opcional: drafts / preview (más adelante)
# SANITY_API_READ_TOKEN=
# Opcional: Instagram
# NEXT_PUBLIC_INSTAGRAM_URL=
